# =========================================================
# AuthHub Environment Configuration
# =========================================================


# =========================================================
# Application
# =========================================================

APP_ENV=development

AUTH_API_ADDR=:8080
CONTROL_API_ADDR=:8081

REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s


# =========================================================
# Build Metadata
# Used by Docker build arguments
# =========================================================

APP_VERSION=dev
GIT_COMMIT=unknown
BUILD_DATE=unknown


# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_DB=authhub
POSTGRES_USER=authhub
POSTGRES_PASSWORD=authhub

# Used when running Go directly on your host machine:
# go run ./cmd/auth-api
POSTGRES_DSN=host=localhost user=authhub password=authhub dbname=authhub port=5432 sslmode=disable TimeZone=UTC


# =========================================================
# Redis
# =========================================================

REDIS_PASSWORD=authhub
REDIS_DB=0

# Used when running Go directly on your host machine
REDIS_ADDR=localhost:6379


# =========================================================
# RabbitMQ
# =========================================================

RABBITMQ_USER=authhub
RABBITMQ_PASSWORD=authhub
RABBITMQ_VHOST=authhub

# Used when running Go directly on your host machine
RABBITMQ_URL=amqp://authhub:authhub@localhost:5672/authhub


# =========================================================
# Vault
# =========================================================

# DEVELOPMENT MODE ONLY
VAULT_DEV_ROOT_TOKEN=dev-root-token

# Used when running Go directly on your host machine
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token